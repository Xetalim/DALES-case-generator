#!/bin/sh
# sample job file to run dales in a folder run_EXPNR. Needs a path to the dales executable.
expnr=001
coldstart="true"
Exp_dir=$(dirname "$0")
cd "$Exp_dir" || exit
RUNDIR="./run_$expnr/"
RUN_NAMELIST="$RUNDIR/namoptions.$expnr"

if [ "$1" = "WARMSTART" ]; then
    coldstart="false"
fi

ensure_warmstart_namelist() {
    namelist_file="$1"
    mkdir -p "$(dirname "$namelist_file")" || exit 1
    [ -f "$namelist_file" ] || return 1
    perl -0pi -e 's{(^\s*&run\b.*?^\s*lwarmstart\s*=\s*)(?:\.true\.|\.false\.)}{$1.true.}ims' "$namelist_file"
}

if [ $coldstart = true ]; then
echo "Cold start"
mkdir -p $RUNDIR

{{required_folders}}
{{required_filetransfers}}
{{required_folder_rsyncs}}

for inp in input/*$expnr*
do
rsync -a $inp $RUNDIR/ || exit
done

if [ "$1" = "NORUN" ]; then
    exit 0
fi
else
echo "Warm start"
ensure_warmstart_namelist "$RUN_NAMELIST" || exit 1
fi
rsync -vt {{dales_exec}} $RUNDIR/dales || echo "Dales exec not found"
cd $RUNDIR || exit

if [ "$1" = "DEBUG" ]; then
    {{debugger}} ./dales namoptions.$expnr
else
    if [ "$1" = "singlecore" ]; then
    ./dales namoptions.$expnr
    else
    mpirun -np {{numcores}} ./dales namoptions.$expnr
    fi
fi
